# .env.example: the list of environment variables the safety assistant reads.
#
# Why this file exists: the app had no backend and no env handling. The safety
# assistant needs API keys and secrets that must never be committed. This file
# only holds names and empty placeholders. Copy it to .env.local (git-ignored)
# and fill in the values there. On Vercel, add the same names under
# Project -> Settings -> Environment Variables.
#
# Every variable here is SERVER-ONLY. None uses the NEXT_PUBLIC_ prefix, so
# Next.js never inlines them into the browser bundle. The browser talks only to
# our own /api routes, and those routes call the providers.
#
# "Needed from" refers to the build steps in the plan:
#   PR 6 = server AI path, PR 7 = escalation + Telegram, PR 8 = Supabase.
# PRs 1-5 run fully in the browser and need none of these.


# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------

# Which speech-to-text adapter to use: "groq" or "none" (no transcription,
# rules-only classification). Empty means "groq".
# Needed from: PR 6.
STT_PROVIDER=

# Which incident classifier to use: "anthropic" (Claude Haiku 4.5) or "rules"
# (free, keyword-based). Empty means "anthropic". If the Anthropic call fails,
# the app falls back to "rules" automatically.
# Needed from: PR 6.
CLASSIFIER_PROVIDER=

# Claude API key used to classify transcribed snippets.
# Get it from: console.anthropic.com -> API Keys (add prepaid credit first).
# Needed from: PR 6.
ANTHROPIC_API_KEY=

# Groq API key used to transcribe audio snippets with Whisper.
# Get it from: console.groq.com -> API Keys.
# Needed from: PR 6.
GROQ_API_KEY=


# ---------------------------------------------------------------------------
# Alerts
# ---------------------------------------------------------------------------

# Which alert adapter to use: "telegram" or "console" (logs alerts instead of
# sending them, for local development). Empty means "console".
# Needed from: PR 7.
NOTIFIER_PROVIDER=

# Token for the Telegram bot that messages emergency contacts.
# Get it from: Telegram -> @BotFather -> /newbot.
# Needed from: PR 7.
TELEGRAM_BOT_TOKEN=

# The bot's username without the "@" (it ends in "bot"). Used to build the
# t.me invite links that contacts tap to register. Not secret.
# Get it from: the /newbot reply in @BotFather.
# Needed from: PR 7.
TELEGRAM_BOT_USERNAME=

# Public base URL of the deployed app, used to build acknowledge links in
# alerts, e.g. https://your-project.vercel.app (no trailing slash). Not secret.
# Set it for Production only. Previews fall back to Vercel's VERCEL_URL, and
# local development falls back to http://localhost:3000.
# Needed from: PR 7.
APP_BASE_URL=


# ---------------------------------------------------------------------------
# Database and audio storage (Supabase)
# ---------------------------------------------------------------------------

# Which store adapter to use: "supabase" or "memory" (in-process, data is lost
# on restart, for local development and tests). Empty means "memory".
# Needed from: PR 8.
STORE_PROVIDER=

# Supabase project URL: the bare URL, e.g. https://<project-ref>.supabase.co
# (do not add /rest/v1/).
# Get it from: Supabase -> Project Settings -> Data API (or API).
# Needed from: PR 8.
SUPABASE_URL=

# Supabase secret key (the "service_role" key, or the newer "sb_secret_..."
# key). It bypasses row-level security, so it must stay on the server. Never
# use the publishable/anon key here; the app does not need that one at all.
# Get it from: Supabase -> Project Settings -> API Keys.
# Needed from: PR 8.
SUPABASE_SERVICE_ROLE_KEY=


# ---------------------------------------------------------------------------
# Secrets you generate yourself (use a different value for each one)
# Generate with:  openssl rand -hex 32
# ---------------------------------------------------------------------------

# Shared secret the monitor page sends with every request, so strangers cannot
# create incidents. You type it into the /monitor page once and the browser
# keeps it. It is deliberately not NEXT_PUBLIC_, because that would publish it
# in the JavaScript bundle.
# Needed from: PR 6.
MONITOR_DEVICE_TOKEN=

# Signs the acknowledge links sent to contacts, so links cannot be forged.
# Changing it invalidates links that have already been sent.
# Needed from: PR 7.
ACK_TOKEN_SECRET=

# Protects /api/escalation/tick. The scheduler (Supabase pg_cron) sends it as
# "Authorization: Bearer <value>".
# Needed from: PR 7 (manual ticks), PR 8 (pg_cron).
CRON_SECRET=

# Telegram sends this in the X-Telegram-Bot-Api-Secret-Token header on every
# webhook call, so we know the request really came from Telegram. Allowed
# characters: A-Z a-z 0-9 _ - (hex output is fine).
# Needed from: PR 7.
TELEGRAM_WEBHOOK_SECRET=


# ---------------------------------------------------------------------------
# Email alerts (AWS SNS)
# ---------------------------------------------------------------------------

# AWS region of the SNS topic, e.g. me-central-1 (UAE) or eu-central-1.
# Must match the region inside AWS_SNS_TOPIC_ARN.
# Get it from: AWS console -> SNS -> Topics (the region in the top bar).
AWS_REGION=

# The SNS topic that emails every subscribed contact, e.g.
# arn:aws:sns:<region>:<account-id>:<topic-name>. Not secret.
# Get it from: AWS console -> SNS -> Topics -> your topic -> ARN.
# Leave empty to turn email alerts off; Telegram alerts keep working.
AWS_SNS_TOPIC_ARN=

# Access key for an IAM user that may only sns:Publish and sns:Subscribe on
# that topic. Not needed when the app runs with an AWS role.
# Get it from: AWS console -> IAM -> Users -> Security credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
