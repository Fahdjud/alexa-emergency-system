# Environment variables for the safety assistant.
#
# Copy to .env.local for local development; set the same names in Vercel for
# deployments. All variables are server-only (no NEXT_PUBLIC_ prefix), so none
# is exposed to the browser. /health reports which ones a deployment can read.

# --- AI check ---------------------------------------------------------------

# Speech-to-text provider: groq (default) or none.
STT_PROVIDER=
# Incident classifier: anthropic (default, Claude Haiku 4.5) or rules.
# Falls back to rules automatically if the Anthropic call fails.
CLASSIFIER_PROVIDER=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# --- Alerts -----------------------------------------------------------------

# Alert channel: telegram, or console (default; logs instead of sending).
NOTIFIER_PROVIDER=
# From @BotFather.
TELEGRAM_BOT_TOKEN=
# Bot username without "@", used in contact invite links.
TELEGRAM_BOT_USERNAME=
# Public URL used in alert links, without a trailing slash. Required in
# production; previews use VERCEL_URL and development uses localhost.
APP_BASE_URL=

# --- Email alerts (optional, AWS SNS) ---------------------------------------

# Set all four or none. The topic must be in AWS_REGION. The IAM user needs
# sns:Publish, sns:Subscribe and sns:ListSubscriptionsByTopic on the topic.
AWS_REGION=
AWS_SNS_TOPIC_ARN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Database ---------------------------------------------------------------

# Store: supabase, or memory (default; development only, lost on restart).
STORE_PROVIDER=
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Secret service-role key (or sb_secret_...). Never the anon/publishable key.
SUPABASE_SERVICE_ROLE_KEY=

# --- Generated secrets --------------------------------------------------------
# Each must be unique and at least 32 characters (A-Z a-z 0-9 _ -), for
# example from `openssl rand -hex 32`. A passphrase of several words joined
# by "-" also works for the household code.

# Household code entered on the monitor; required by every monitor API call.
MONITOR_DEVICE_TOKEN=
# Signs the answer links in alerts. Changing it invalidates links already sent.
ACK_TOKEN_SECRET=
# Authenticates the scheduler's calls to /api/escalation/tick.
CRON_SECRET=
# Sent by Telegram with every webhook call (setWebhook secret_token).
TELEGRAM_WEBHOOK_SECRET=
